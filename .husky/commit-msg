#!/usr/bin/env sh
set -e

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

if ! echo "$COMMIT_MSG" | grep -qE '^(feat|fix|refactor|docs|test|chore|ci|build|perf)(\(.+\))?!?: .+'; then
    echo "[Husky commit-msg ERROR] Commit message must follow Conventional Commits format:"
    echo "  e.g. feat(nfc): support Play Store AAB bundle and API 35 target"
    echo "  Got: $COMMIT_MSG"
    exit 1
fi
