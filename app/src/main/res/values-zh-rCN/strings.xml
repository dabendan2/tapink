    <string name="ui_color_bw">黑白双色</string>
    <string name="ui_color_bwr">黑白红三色</string>
    <string name="ui_color_bwry">黑白红黄</string>
    <string name="ui_color_spectra6">六色全彩</string>

    <!-- Accessibility Announcements -->
    <string name="ui_a11y_transferring">已感应到电子纸，正在传输，请保持不动</string>
    <string name="ui_a11y_success">电子纸更新完成</string>
