    <string name="ui_btn_portrait">竖向</string>
    <string name="ui_btn_landscape">横向</string>
    <string name="ui_btn_cancel">取消</string>
    <string name="ui_btn_close">关闭</string>
    <string name="ui_btn_retry">重新感应</string>
    <string name="ui_btn_enable_nfc">开启 NFC</string>

