{
  "name": "tapink",
  "version": "2.4.0",
  "private": true,
  "license": "MIT",
  "description": "TapInk (瞬墨): Effortless, 100% offline NFC E-Paper & smart badge updater for Android.",
  "keywords": [
    "nfc",
    "e-paper",
    "e-ink",
    "epaper",
    "eink",
    "smart-badge",
    "digital-business-card",
    "desk-sign",
    "santek",
    "ez-sign",
    "spectra-6",
    "floyd-steinberg",
    "android",
    "offline-first",
    "passive-nfc",
    "battery-free",
    "obtainium",
    "電子紙",
    "智慧識別證",
    "數位名片",
    "會議桌牌"
  ],
  "homepage": "https://github.com/dabendan2/tapink#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dabendan2/tapink.git"
  },
  "bugs": {
    "url": "https://github.com/dabendan2/tapink/issues"
  },
  "scripts": {
    "prepare": "husky",
    "build": "bash ./scripts/build-and-test.sh",
    "test": "bash ./scripts/build-and-test.sh",
    "test:e2e": "bash ./scripts/build-and-test.sh --e2e-emulator",
    "assets:store": "python3 ./scripts/generate-store-assets.py",
    "lint": "python3 -m py_compile tests/emulator-e2e.test.py scripts/generate-store-assets.py && bash -n scripts/build-and-test.sh",
    "deploy:device": "bash ./scripts/build-and-test.sh --install-device"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
